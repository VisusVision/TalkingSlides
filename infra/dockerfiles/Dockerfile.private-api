# syntax=docker/dockerfile:1.7
# Optional private-media API variant: exact worker image by immutable image ID
# or registry digest. No apt/pip layer can change its native runtime identities.
# Ordinary Dockerfile.api remains the small default. No test harness is copied.
ARG PRIVATE_WORKER_IMAGE
FROM ${PRIVATE_WORKER_IMAGE}
WORKDIR /app/api
ENV PYTHONPATH=/app/api:/app
USER appuser
# API does not execute CUDA startup hooks; native bytes/libraries stay intact.
ENTRYPOINT []
EXPOSE 8000
CMD ["gunicorn", "--bind", "0.0.0.0:8000", "--workers", "2", "config.wsgi:application"]
